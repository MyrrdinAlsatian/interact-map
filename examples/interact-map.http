### [WRITE] Ingestion parser — docker-compose valide schemaVersion 1.0 — expect 200
# POST {{base}}/parser/ingest
# Content-Type: application/json
#
# {
#   "parserResult": {
#     "schemaVersion": "1.0",
#     "nodes": [
#       {"id": "container:web", "type": "container", "label": "web", "metadata": {"docker_image": "nginx:alpine"}},
#       {"id": "container:api", "type": "container", "label": "api", "metadata": {"docker_image": "acme/api:1.0"}}
#     ],
#     "edges": [
#       {"id": "depends:web->api", "source": "container:web", "target": "container:api", "criticality": "high", "dependencyType": "required", "protocol": "docker-network"}
#     ],
#     "errors": [],
#     "warnings": []
#   },
#   "base": {"schemaVersion": "1.0", "nodes": [], "edges": [], "errors": []}
# }

###

### [WRITE] Ingestion parser — schemaVersion 0.9 (précédente) — expect 200 avec warnings
# POST {{base}}/parser/ingest
# Content-Type: application/json
#
# {
#   "parserResult": {
#     "schemaVersion": "0.9",
#     "nodes": [{"id": "container:db", "type": "container", "label": "db", "metadata": {"docker_image": "postgres:16"}}],
#     "edges": [],
#     "errors": [],
#     "warnings": [{"code": "VERSION_PREVIOUS", "message": "Using previous schema version 0.9.", "severity": "warning"}]
#   },
#   "base": {"schemaVersion": "1.0", "nodes": [], "edges": [], "errors": []}
# }

###

