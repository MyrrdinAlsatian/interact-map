# ──────────────────────────────────────────────────────────────────────────────

### [WRITE] Valider un contrat de graphe — expect 200 { valid: true, errors: [] }
# POST {{base}}/graph/contract/validate
# Content-Type: application/json
#
# {
#   "schemaVersion": "1.0",
#   "nodes": [
#     {"id": "app-web",    "type": "application", "label": "Web Frontend"},
#     {"id": "app-orders", "type": "application", "label": "Orders API"},
#     {"id": "svc-db",     "type": "service",     "label": "PostgreSQL"}
#   ],
#   "edges": [
#     {"id": "e1", "source": "app-web",    "target": "app-orders", "criticality": "high",     "dependencyType": "required", "protocol": "https"},
#     {"id": "e2", "source": "app-orders", "target": "svc-db",     "criticality": "critical", "dependencyType": "required", "protocol": "tcp"}
#   ],
#   "errors": []
# }

###

### [WRITE] Valider contrat invalide — expect 422 avec errors[]
# POST {{base}}/graph/contract/validate
# Content-Type: application/json
#
# {
#   "schemaVersion": "1.0",
#   "nodes": [
#     {"id": "app-web", "type": "application"}
#   ],
#   "edges": [],
#   "errors": []
# }

###

