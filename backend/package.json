{
  "name": "interact-map-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0",
    "npm": ">=10.0.0"
  },
  "imports": {
    "#entity/*": "./src/domain/models/*.js",
    "#domain/*": "./src/domain/*.js",
    "#usecases/*": "./src/domain/usecases/*.js",
    "#contracts/*": "./src/domain/contracts/*.js",
    "#infrastructure/*": "./src/infrastructure/*.js",
    "#controllers/*": "./src/infrastructure/controllers/*.js",
    "#exceptions/*": "./src/infrastructure/exceptions/*.js",
    "#listeners/*": "./src/infrastructure/listeners/*.js",
    "#events/*": "./src/infrastructure/events/*.js",
    "#middleware/*": "./src/infrastructure/middleware/*.js",
    "#repositories/*": "./src/infrastructure/repositories/*.js",
    "#providers/*": "./providers/*.js",
    "#services/*": "./services/*.js",
    "#policies/*": "./policies/*.js",
    "#abilities/*": "./abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "scripts": {
    "dev": "node ace.js serve --watch",
    "start": "node ace.js serve",
    "test": "node --import tsx --test tests/unit/**/*.spec.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.3.0",
    "@adonisjs/core": "^6.13.1",
    "@adonisjs/lucid": "^21.3.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.44.0",
    "@types/node": "^22.19.15",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
