@layout('layout', { title: 'Architecture Graph' })

@slot('content')
  <h2 class="page-title">Architecture Graph</h2>

  <div class="graph-toolbar" style="display:flex;gap:8px;margin-bottom:12px;align-items:center;">
    <input id="nodeInput" placeholder="Failed node id (e.g. app-orders)" style="padding:7px 10px;border:1px solid #ced4da;border-radius:6px;min-width:220px;" />
    <select id="modeSelect" style="padding:7px 10px;border:1px solid #ced4da;border-radius:6px;">
      <option value="bfs">BFS</option>
      <option value="dfs">DFS</option>
    </select>
    <button id="simulateButton" type="button" style="padding:7px 14px;background:#1971c2;color:#fff;border:none;border-radius:6px;cursor:pointer;">
      Simulate incident
    </button>
  </div>

  <architecture-graph id="architectureGraph" style="display:block;width:100%;height:540px;border:1px solid #dee2e6;border-radius:8px;"></architecture-graph>

  <pre id="incidentOutput" aria-live="polite" style="background:#f1f3f5;padding:12px;border-radius:6px;margin-top:12px;font-size:.85rem;min-height:48px;"></pre>

  <script type="module">
    import '/frontend/components/architecture-graph.js';

    const graphEl = document.getElementById('architectureGraph');
    const output  = document.getElementById('incidentOutput');

    @if(initialContract)
      const contract = {{{ initialContract }}};
      graphEl.loadGraph(contract);
    @endif

    graphEl.addEventListener('contract-validation-error', ({ detail }) => {
      output.textContent = 'Contract validation errors:\n' + JSON.stringify(detail.errors, null, 2);
    });

    document.getElementById('simulateButton').addEventListener('click', () => {
      const nodeId = document.getElementById('nodeInput').value.trim();
      const mode   = document.getElementById('modeSelect').value;
      if (!nodeId) { output.textContent = 'Enter a node id first.'; return; }
      const result = graphEl.simulateIncident(nodeId, mode);
      output.textContent = JSON.stringify(result, null, 2);
    });
  </script>
@endslot
