@layout('layout')
@set('title', 'Architecture Graph')

@section('content')
  <div class="page-title"><i class="fas fa-project-diagram"></i> Architecture Graph</div>
  <p class="page-subtitle">Real-time infrastructure topology and dependencies</p>

  <!-- SUMMARY STRIP -->
  <div class="grid grid-3" style="margin-bottom: 24px;">
    <div class="stat-card">
      <div class="stat-value">{{ summary.nodeCount }}</div>
      <div class="stat-label"><i class="fas fa-circle-nodes"></i> Nodes</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ summary.edgeCount }}</div>
      <div class="stat-label"><i class="fas fa-arrows-alt"></i> Dependencies</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ summary.applications }}</div>
      <div class="stat-label"><i class="fas fa-cube"></i> Applications</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ summary.services }}</div>
      <div class="stat-label"><i class="fas fa-cogs"></i> Services</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ summary.servers }}</div>
      <div class="stat-label"><i class="fas fa-server"></i> Servers</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ summary.containers }}</div>
      <div class="stat-label"><i class="fas fa-box"></i> Containers</div>
    </div>
  </div>

  <div class="card">
    <h2 id="graph-page-title" class="card-title">Infrastructure Visualization</h2>
    <p id="graphHelp" style="margin: 0 0 16px; color: var(--text-secondary); font-size: 0.9rem;">
      <i class="fas fa-keyboard"></i> Keyboard tips: Tab to controls, Enter to simulate, use <strong>+ / -</strong> to zoom, arrow keys to pan
    </p>

    <form id="graphToolbar" class="graph-toolbar" style="display: flex; gap: 8px; margin-bottom: 16px; align-items: center;">
      <label for="nodeInput" style="font-size: 0.85rem; font-weight: 600;">Failed node</label>
      <input id="nodeInput" placeholder="e.g., app-orders" aria-label="Failed node id" style="padding: 8px 12px; background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; color: var(--text-primary); flex: 1; max-width: 220px;" />

      <label for="modeSelect" style="font-size: 0.85rem; font-weight: 600;">Traversal</label>
      <select id="modeSelect" aria-label="Incident traversal mode" style="padding: 8px 12px; background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; color: var(--text-primary);">
        <option value="bfs">Breadth-First</option>
        <option value="dfs">Depth-First</option>
      </select>

      <button id="simulateButton" type="submit" style="padding: 8px 16px; background: var(--danger); color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;">
        <i class="fas fa-bolt"></i> Simulate Incident
      </button>
    </form>

    <architecture-graph id="architectureGraph" aria-labelledby="graph-page-title" aria-describedby="graphHelp" style="display: block; width: 100%; height: 600px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-dark);"></architecture-graph>

    <pre id="incidentOutput" aria-live="polite" style="background: rgba(0, 82, 204, 0.1); padding: 16px; border-radius: 6px; margin-top: 16px; font-size: 0.85rem; min-height: 48px; color: var(--text-primary); border: 1px solid var(--border); overflow-x: auto;"></pre>
  </div>

  <script type="module">
    import '/frontend/components/architecture-graph.js';

    const graphEl = document.getElementById('architectureGraph');
    const output = document.getElementById('incidentOutput');

    @if(initialContract)
      const contract = {{{ initialContract }}};
      graphEl.loadGraph(contract);
    @endif

    graphEl.addEventListener('contract-validation-error', ({ detail }) => {
      output.textContent = 'Contract validation errors:\n' + JSON.stringify(detail.errors, null, 2);
      output.style.color = 'var(--danger)';
    });

    document.getElementById('graphToolbar').addEventListener('submit', (event) => {
      event.preventDefault();
      const nodeId = document.getElementById('nodeInput').value.trim();
      const mode = document.getElementById('modeSelect').value;

      if (!nodeId) {
        output.textContent = '⚠ Enter a node id first';
        output.style.color = 'var(--warning)';
        return;
      }

      const result = graphEl.simulateIncident(nodeId, mode);
      output.textContent = JSON.stringify(result, null, 2);
      output.style.color = 'var(--text-primary)';
    });
  </script>
@endsection
