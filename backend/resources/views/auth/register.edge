<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account · Interact Map</title>
    <style>
      :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #0f111d; color: #e8eaed; }
      * { box-sizing: border-box; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; }
      main { width: min(100%, 420px); padding: 32px; border: 1px solid #2a2d3d; border-radius: 12px; background: #1a1d2e; }
      h1 { margin: 0 0 8px; font-size: 1.6rem; }
      p { color: #b0b4ba; }
      label { display: block; margin-top: 18px; font-weight: 600; }
      input { display: block; width: 100%; margin-top: 6px; padding: 11px 12px; border: 1px solid #4a4e60; border-radius: 6px; background: #0f111d; color: inherit; font: inherit; }
      button { width: 100%; margin-top: 24px; padding: 12px; border: 0; border-radius: 6px; background: #1769e0; color: white; font: inherit; font-weight: 700; cursor: pointer; }
      a { color: #8bb8ff; }
      .error { padding: 10px 12px; border-radius: 6px; background: #492b31; color: #ffd8dc; }
      :focus-visible { outline: 3px solid #8bb8ff; outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main id="main-content">
      <h1>Create an account</h1>
      <p>New accounts start with viewer access.</p>

      @if(error)
        <p class="error" role="alert">{{ error }}</p>
      @endif

      <form method="POST" action="/users/register">
        <label for="displayName">Display name</label>
        <input id="displayName" name="displayName" type="text" value="{{ displayName ?? '' }}" autocomplete="name" required />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="{{ email ?? '' }}" autocomplete="email" required />

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />

        <button type="submit">Create account</button>
      </form>

      <p>Already have an account? <a href="/login">Sign in</a></p>
    </main>
  </body>
</html>
