@layout('layout')
@set('title', 'Dashboard')

@section('content')
  <div class="page-title"><i class="fas fa-tachometer-alt"></i> Dashboard</div>
  <p class="page-subtitle">Real-time infrastructure monitoring and status overview</p>

  <div class="grid grid-2" style="margin-bottom: 24px;">
    <div class="card">
      <div class="card-title">
        <i class="fas fa-file-import"></i> Import infrastructure data
      </div>
      <form method="POST" action="/uploads" enctype="multipart/form-data">
        <div class="form-row form-row-stack">
          <label>
            <span class="field-label">Source type</span>
            <select name="sourceType" class="input">
              <option value="">Auto-detect</option>
              <option value="docker-compose">docker-compose</option>
              <option value="docker-inspect">docker-inspect</option>
              <option value="docker-ps">docker-ps</option>
            </select>
          </label>
          <label>
            <span class="field-label">Schema version</span>
            <input type="text" name="schemaVersion" value="1.0" class="input" />
          </label>
          <label>
            <span class="field-label">Upload file</span>
            <input type="file" name="file" class="input" />
          </label>
        </div>
        <div class="action-row" style="margin-top: 12px;">
          <button type="submit" class="btn"><i class="fas fa-upload"></i> Import and merge</button>
        </div>
      </form>
    </div>

    <div class="card">
      <div class="card-title">
        <i class="fas fa-code-compare"></i> Latest import diff
      </div>
      @if(latestImport)
        <p style="color: var(--text-secondary); margin-bottom: 12px;">
          {{ latestImport.sourceType }} imported at {{ latestImport.timestamp }}
        </p>
        <div class="grid grid-2">
          <div>
            <div class="stat-value" style="font-size: 1.6rem;">{{ latestImport.addedNodeIds.length }}</div>
            <div class="stat-label">Added nodes</div>
          </div>
          <div>
            <div class="stat-value" style="font-size: 1.6rem;">{{ latestImport.addedEdgeIds.length }}</div>
            <div class="stat-label">Added edges</div>
          </div>
          <div>
            <div class="stat-value" style="font-size: 1.6rem;">{{ latestImport.skippedNodeIds.length }}</div>
            <div class="stat-label">Skipped nodes</div>
          </div>
          <div>
            <div class="stat-value" style="font-size: 1.6rem;">{{ latestImport.skippedEdgeIds.length }}</div>
            <div class="stat-label">Skipped edges</div>
          </div>
        </div>
        <div class="action-row" style="margin-top: 16px;">
          <a href="/imports/latest" up-follow class="btn btn-secondary">Open diff view</a>
        </div>
      @else
        <p style="color: var(--text-secondary);">No import diff available yet.</p>
      @endif
    </div>
  </div>

  <!-- STATS GRID -->
  <div class="grid grid-3" style="margin-bottom: 32px;">
      @each(stat in stats)
        <div class="stat-card">
          <div class="stat-value">{{ stat.value }}</div>
          <div class="stat-label"><i class="fas {{ stat.icon }}"></i> {{ stat.label }}</div>
        </div>
      @endeach
  </div>

  <!-- INFO CARDS -->
  <div class="grid grid-2">
    <!-- SYSTEM STATUS -->
    <div class="card">
      <div class="card-title">
        <i class="fas fa-heartbeat"></i> System Status
      </div>
      <table>
        <tbody>
          <tr>
            <td><strong>API Gateway</strong></td>
            <td style="text-align: right;"><span class="badge badge-online">● Online</span></td>
          </tr>
          <tr>
            <td><strong>Database</strong></td>
            <td style="text-align: right;"><span class="badge badge-online">● Online</span></td>
          </tr>
          <tr>
            <td><strong>Cache Layer</strong></td>
            <td style="text-align: right;"><span class="badge badge-online">● Online</span></td>
          </tr>
          <tr>
            <td><strong>Message Queue</strong></td>
            <td style="text-align: right;"><span class="badge badge-online">● Online</span></td>
          </tr>
          <tr>
            <td><strong>Monitoring</strong></td>
            <td style="text-align: right;"><span class="badge badge-online">● Online</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- RECENT ACTIVITY -->
    <div class="card">
      <div class="card-title">
        <i class="fas fa-history"></i> Recent Activity
      </div>
      <div style="font-size: 0.9rem; line-height: 2;">
          @each(activity in recentActivity)
            <div style="padding: 8px 0; border-bottom: 1px solid var(--border);">
              <span style="color: var(--{{ activity.tone === 'warning' ? 'warning' : 'success' }});">{{ activity.tone === 'warning' ? '⚠' : '✓' }}</span> {{ activity.title }}
              <div style="font-size: 0.8rem; color: var(--text-secondary);">{{ activity.detail }}</div>
            </div>
          @endeach
      </div>
    </div>

    <!-- TOP APPLICATIONS -->
    <div class="card">
      <div class="card-title">
        <i class="fas fa-chart-bar"></i> Top Applications (by traffic)
      </div>
      <table style="margin-top: 12px;">
        <tbody>
            @each(application in topApplications)
              <tr>
                <td><strong>{{ application.label }}</strong></td>
                <td style="text-align: right; color: var(--{{ application.tone === 'success' ? 'success' : 'text-secondary' }});">{{ application.trend }}</td>
              </tr>
            @endeach
        </tbody>
      </table>
    </div>

    <!-- NETWORK DIAGRAM QUICK LINK -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
      <i class="fas fa-project-diagram" style="font-size: 3rem; color: var(--primary); margin-bottom: 16px;"></i>
      <h3 style="margin-bottom: 8px;">View Architecture</h3>
      <p style="color: var(--text-secondary); margin-bottom: 16px;">Visualize your complete infrastructure topology</p>
      <a href="/graph" up-follow class="btn"><i class="fas fa-arrow-right"></i> Open Graph</a>
    </div>
  </div>

