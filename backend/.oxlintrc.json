{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["database/migrations/**/*", ".adonisjs/**/*", "build/**/*"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "unicorn/no-useless-spread": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  }
}
